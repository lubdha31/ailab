def dfs(x, y, visited, path):
    if (x, y) in visited:
        return False

    visited.add((x, y))
    path.append((x, y))

    if x == 2 or y == 2:
        print("Solution:", path)
        return True

    moves = [
        (4, y), (x, 3), (0, y), (x, 0),
        (x - min(x, 3-y), y + min(x, 3-y)),
        (x + min(y, 4-x), y - min(y, 4-x))
    ]

    for nx, ny in moves:
        if dfs(nx, ny, visited, path):
            return True

    path.pop()
    return False


visited = set()
path = []

dfs(0, 0, visited, path)
