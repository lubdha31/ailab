import random

def calculate_distance(route, dist):
    total = 0
    for i in range(len(route)):
        total += dist[route[i]][route[(i + 1) % len(route)]]
    return total

def get_neighbors(route):
    neighbors = []
    for i in range(len(route)):
        for j in range(i + 1, len(route)):
            new_route = route[:]
            new_route[i], new_route[j] = new_route[j], new_route[i]
            neighbors.append(new_route)
    return neighbors

def local_beam_search(dist, k):
    n = len(dist)

    beam = []
    for _ in range(k):
        route = list(range(n))
        random.shuffle(route)
        beam.append(route)

    best_route = None
    best_distance = float('inf')

    for _ in range(100):
        candidates = []

        for route in beam:
            for neighbor in get_neighbors(route):
                candidates.append(neighbor)

        candidates.sort(key=lambda x: calculate_distance(x, dist))
        beam = candidates[:k]

        current_distance = calculate_distance(beam[0], dist)

        if current_distance < best_distance:
            best_distance = current_distance
            best_route = beam[0][:]

    return best_route, best_distance


# Distance matrix
dist = [
    [0, 10, 15, 20],
    [10, 0, 35, 25],
    [15, 35, 0, 30],
    [20, 25, 30, 0]
]

k = 3

route, distance = local_beam_search(dist, k)

print("Best Route:", route)
print("Minimum Distance:", distance)
